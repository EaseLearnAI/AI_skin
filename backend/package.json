{
  "name": "ai_skin_backend",
  "version": "1.0.0",
  "description": "AI Skincare System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest tests/unit --runInBand",
    "test:contract": "jest tests/contract --runInBand",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles",
    "test:e2e:real": "RUN_REAL_E2E=1 jest tests/e2e/realLocal.e2e.test.js --runInBand --detectOpenHandles",
    "check": "node --check server.js && node --check src/index.js",
    "payment:check-sandbox": "node -- scripts/check-alipay-sandbox.js"
  },
  "keywords": [
    "ai",
    "skincare",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ali-oss": "^6.23.0",
    "alipay-sdk": "4.14.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "overrides": {
    "alipay-sdk": {
      "urllib": "4.9.1"
    }
  }
}
