# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/aiskin

# Auth
JWT_SECRET=change_this_to_a_secure_random_value
JWT_EXPIRES_IN=7d

# DashScope / Qwen compatible API
API_KEY=your_dashscope_api_key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TEXT_MODEL=qwen3.7-flash
AI_VISION_MODEL=qwen3-vl-plus
AI_OCR_MODEL=qwen-vl-ocr-latest
AI_TIMEOUT_MS=100000

# Aliyun OSS. Required in production; face images are always private.
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_AUTHORIZATION_V4=false
OSS_PRODUCT_IMAGES_PUBLIC=false
OSS_FACE_SIGNED_URL_EXPIRES_SECONDS=900

# Native Sign in with Apple
APPLE_AUDIENCE=personal.AIskin
APPLE_TEAM_ID=9CUS5VPDW7
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REFRESH_TOKEN_ENCRYPTION_KEY=

# Private SMS gateway used for password reset codes
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_TIMEOUT_MS=5000

# Alipay AI mobile app collection. Disabled until merchant/sandbox setup is complete.
# APPLE_* above is Sign in with Apple only; Apple IAP is reserved, not implemented here.
ALIPAY_ENABLED=false
ALIPAY_ENVIRONMENT=sandbox
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Alternatively, absolute local PEM/key file paths (do not commit key files):
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_NOTIFY_URL=
# Prices are integer fen. Explicit values are required when enabling production.
MEMBERSHIP_MONTH_PRICE_FEN=1200
MEMBERSHIP_YEAR_PRICE_FEN=8800
